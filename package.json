{
  "name": "nodo",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "bun --cwd apps/mobile run start",
    "mobile:android": "bun --cwd apps/mobile run android",
    "mobile:ios": "bun --cwd apps/mobile run ios",
    "mobile:web": "bun --cwd apps/mobile run web",
    "mobile:lint": "bun --cwd apps/mobile run lint",
    "server:dev": "bun --cwd apps/server run dev",
    "server:test": "bun --cwd apps/server test",
    "shared:test": "bun --cwd packages/shared test",
    "release": "bun --cwd apps/mobile run release",
    "release:ci": "bun --cwd apps/mobile run release:ci"
  }
}
